# 腾讯云 COS 私有存储配置。只放在本地 .secrets/cos.env，绝不提交。
# SecretId/SecretKey 请在腾讯云 CAM 中创建最小权限密钥，不要发到聊天里。
COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Bucket 名称需包含控制台显示的 APPID，例如 materials-1250000000
COS_BUCKET=materials-1250000000
# 北京地域一般是 ap-beijing
COS_REGION=ap-beijing
# 留空则使用 COS 原生域名；也可以填写完整 https://... 地址
COS_ENDPOINT=
COS_SIGNED_URL_TTL=1800
COS_UPLOAD_URL_TTL=3600
