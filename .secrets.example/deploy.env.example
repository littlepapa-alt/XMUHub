# ssh 登录的服务器
SSH_HOST=your-server.example.com
SSH_USER=root
# 网站地址（不要末尾的 /）
PUBLIC_URL=https://hub.example.com
# 用哪个站点文件夹：site/<SITE>/（先复制 site/example 改成自己的）
SITE=example
# 宝塔面板的站点扩展配置目录（放上传中转的 nginx 路由）；不用宝塔就留空
NGINX_EXT_DIR=
# scripts/cf_cache_rules.py 用：Cloudflare 上的区域（根域名）和网站的主机名
CF_ZONE=example.com
CF_HOST=hub.example.com
# 可选：覆盖 mail.env 里的 SMTP_PORT（服务器封了 465 时用 80，程序在非 465 端口上强制 STARTTLS）
# SMTP_PORT=80
# 另一台服务器（备用机）：复制本文件为 deploy.<名字>.env，用 deploy.ps1 / sync.ps1 -Target <名字>
