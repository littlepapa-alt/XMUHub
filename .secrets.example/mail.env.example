# 发送注册 / 找回密码验证码的 SMTP；不填则只能由管理员在服务器上开账号
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com

# 可选备用账号：主账号发送失败时尝试；留空授权码则不启用。
# 网易 163 / 126 / yeah.net 分别使用 smtp.163.com / smtp.126.com / smtp.yeah.net。
# PASSWORD 填邮箱设置中启用 SMTP 后生成的授权码，不是登录密码。
SMTP_BACKUP_HOST=smtp.163.com
SMTP_BACKUP_PORT=465
SMTP_BACKUP_USER=
SMTP_BACKUP_PASSWORD=
MAIL_BACKUP_FROM=
